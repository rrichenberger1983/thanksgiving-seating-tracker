# Public values only (safe in the browser). NEVER put a service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Email of the single shared staff Auth user. Staff sign in with username "thanksgiving" + the password.
# The PASSWORD is never put in code, env vars, or the repo.
VITE_STAFF_LOGIN_EMAIL=thanksgiving-staff@example.org
